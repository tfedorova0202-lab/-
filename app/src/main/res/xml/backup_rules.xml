<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Защита персональных и финансовых данных: исключение БД долгов и настроек из резервных копий -->
    <exclude domain="database" path="app_database" />
    <exclude domain="database" path="app_database-wal" />
    <exclude domain="database" path="app_database-shm" />
    <exclude domain="sharedpref" path="user_prefs.xml" />
</full-backup-content>
